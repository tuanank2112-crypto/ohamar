# Facebook Page Messenger → Lead Core
# Copy to services/fb-messenger/.env — never commit secrets

FB_MESSENGER_HOST=127.0.0.1
FB_MESSENGER_PORT=18793

# Meta App (developers.facebook.com)
FB_VERIFY_TOKEN=change-me-verify-token
FB_PAGE_ACCESS_TOKEN=
FB_APP_SECRET=
# Optional: only process this page id
FB_PAGE_ID=

# Lead Core
LEAD_CORE_URL=http://127.0.0.1:18792
LEAD_CORE_TOKEN=

# Auto-reply mode: off | safe_faq
# safe_faq = hotline/address/product list from brand-kits only (no invented claims)
FB_AUTO_REPLY=safe_faq

# Brand kits root (for safe FAQ)
OHAMAR_ROOT=/home/lenkuy/ohamar
BRAND_KITS=workspace/brand-kits/vicamed

# Public webhook path (behind reverse proxy / tunnel)
# https://your-domain/webhook/facebook
