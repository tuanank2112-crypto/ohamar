# Lead Core — copy to services/lead-core/.env (never commit)
LEAD_CORE_HOST=127.0.0.1
LEAD_CORE_PORT=18792
LEAD_CORE_TOKEN=change-me-to-a-long-random-string
LEAD_CORE_DB=./data/lead.db
# send-lease TTL seconds
LEAD_CORE_LEASE_TTL_SEC=45
# retention days (metadata; documented for NĐ 13 ops)
LEAD_CORE_RETENTION_DAYS=365
# P8: CORS allowlist — danh sách origin cho phép gọi từ trình duyệt, phân tách bằng dấu phẩy.
# Phải gồm scheme + host (+ port nếu có). KHÔNG dùng '*'. Để TRỐNG = tắt CORS (an toàn).
# Ví dụ: LEAD_CORE_ALLOWED_ORIGINS=https://crm.your-domain.com,https://localhost:3000
LEAD_CORE_ALLOWED_ORIGINS=
