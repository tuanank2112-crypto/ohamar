{
  "name": "ohamar",
  "version": "1.0.0",
  "description": "Ohamar — Personal AI assistant (local). OpenClaw core + ZaloClaw channel, branded and isolated for self-host.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "ohamar": "./bin/ohamar.mjs"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "OHAMAR_INSTANCE=main node scripts/start.mjs",
    "stop": "OHAMAR_INSTANCE=main node scripts/stop.mjs",
    "start:worker": "OHAMAR_INSTANCE=worker node scripts/start.mjs",
    "stop:worker": "OHAMAR_INSTANCE=worker node scripts/stop.mjs",
    "status": "OHAMAR_INSTANCE=main node scripts/status.mjs",
    "status:worker": "OHAMAR_INSTANCE=worker node scripts/status.mjs",
    "health": "OHAMAR_INSTANCE=main node scripts/health.mjs",
    "health:worker": "OHAMAR_INSTANCE=worker node scripts/health.mjs",
    "watchdog": "OHAMAR_INSTANCE=main node scripts/watchdog.mjs",
    "watchdog:worker": "OHAMAR_INSTANCE=worker node scripts/watchdog.mjs",
    "backup": "node scripts/backup.mjs all",
    "backup:main": "node scripts/backup.mjs main",
    "backup:worker": "node scripts/backup.mjs worker",
    "cleanup:legacy": "node scripts/cleanup-legacy.mjs",
    "zalo:login": "OHAMAR_INSTANCE=main node scripts/zalo-login.mjs",
    "zalo:login:worker": "OHAMAR_INSTANCE=worker node scripts/zalo-login.mjs",
    "dashboard": "OHAMAR_INSTANCE=main node scripts/dashboard.mjs",
    "dashboard:worker": "OHAMAR_INSTANCE=worker node scripts/dashboard.mjs",
    "agent": "OHAMAR_INSTANCE=main node scripts/agent.mjs",
    "agent:worker": "OHAMAR_INSTANCE=worker node scripts/agent.mjs",
    "doctor": "OHAMAR_INSTANCE=main node scripts/doctor.mjs",
    "doctor:worker": "OHAMAR_INSTANCE=worker node scripts/doctor.mjs",
    "cli": "OHAMAR_INSTANCE=main node scripts/cli.mjs",
    "cli:worker": "OHAMAR_INSTANCE=worker node scripts/cli.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "cards:validate": "node scripts/validate-product-cards.mjs --brand vicamed",
    "cards:export": "node scripts/cards-export.mjs",
    "cards:gap": "node scripts/sheet-gap-report.mjs",
    "cards:cases": "node scripts/cards-cases.mjs",
    "cards:cases:vicamed": "node scripts/cards-cases.mjs workspace/brand-kits/vicamed/Database_Chatbot.xlsx",
    "cases:index": "node scripts/rebuild-case-index.mjs",
    "drive:doctor": "node scripts/drive-doctor.mjs",
    "lead-core:migrate": "node services/lead-core/src/migrate.mjs",
    "lead-core:start": "node services/lead-core/src/server.mjs",
    "lead-core:backup": "node services/lead-core/src/backup.mjs",
    "lead-core:watch": "node services/lead-core/src/watch.mjs",
    "lead-core:watch-cron": "node services/lead-core/src/watch-cron.mjs",
    "lead-core:health": "node services/lead-core/src/health-cli.mjs",
    "lead-core:install-skills": "node services/lead-core/install-skills.mjs",
    "lead-core:register-cron": "node services/lead-core/src/register-cron.mjs",
    "lead-core:gate": "node services/lead-core/src/outbound-gate.mjs",
    "lead-core:backup-cron": "node services/lead-core/src/backup.mjs",
    "stack:start": "node scripts/start-stack.mjs",
    "lead-core:backup-daily": "node services/lead-core/src/backup.mjs",
    "lead-core:apply-bridge": "node services/lead-core/apply-zaloclaw-bridge.mjs",
    "lead-core:doctor": "node services/lead-core/src/doctor.mjs",
    "fb:start": "node services/fb-messenger/src/server.mjs",
    "fb:health": "node services/fb-messenger/src/health-cli.mjs"
  },
  "dependencies": {
    "openclaw": "^2026.7.1"
  },
  "ohamar": {
    "defaultPort": 18789,
    "stateDir": "./data",
    "workspace": "./workspace",
    "plugins": [
      "vendor/zaloclaw"
    ]
  }
}
